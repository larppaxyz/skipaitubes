{
  "manifest_version": 3,
  "name": "Skip AI Tunes",
  "author": "Lari Temmes",
  "version": "1.3.0",
  "description": "Skip AI-tagged playlist videos or block AI-tagged videos across YouTube, including Home and search.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["rules.js", "counter.js", "navigation.js", "content.js", "block.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
